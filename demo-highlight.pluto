-- 3. Keywords and modifiers -------------------------------------------
local a <const> = 1
local b <close> = nil
local g = 10

if a == 1 then
    print("one")
elseif a == 2 then
    print("two")
else
    print("many")
end

for i = 1, 10, 2 do
    if i == 3 then continue end
    if i > 7 then break end
end

for key, value in pairs({ x = 1, y = 2 }) do
    print(key, value)
end

local n = 0
while n < 3 do n = n + 1 end
repeat n = n - 1 until n <= 0

do
    local scoped = true
end

goto done
::done::

-- 4. Operators ---------------------------------------------------------
local math_ops = 1 + 2 - 3 * 4 / 5 // 6 % 7 ^ 2
local bit_ops = 1 & 2 | 3 ~ 4 << 5 >> 6
local compare = 1 == 2 or 3 ~= 4 and 5 <= 6 or 7 >= 8 or not (9 < 10)
local concat = "a" .. "b" .. 1
local length = #"text"
local ternary = a ? "yes" : "no"
local coalesce = nothing ?? "default"
local safe = g?.field
local safe_index = g?[1]
local compound = 1
compound += 1
compound -= 1
compound *= 2
compound /= 2
compound ..= "x"
compound ??= 0

