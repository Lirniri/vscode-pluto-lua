-- 5. Functions, parameters and types ---------------------------------
local function plain(a, b) return a + b end

function typed(count: int, name: string, ratio: float, ok: bool): string
    return name
end

function nullable(a: int?, b: ?string, c: Vehicle?): bool? return nil end
function unions(a: int|string, b: ?int|string?, c: number|nil|bool): void end
function tables_as_types(point: { x: number, y: number }, list: { int }): table return {} end
function with_default(a: int = 5, b: string = "x", ...) end
function variadic(...args: any) return ... end

local lambda = |x, y| -> x + y
local typed_lambda = |x: int, y: int| -> int { return x + y }
local arrow = function(x) return x * 2 end

function api_add(a: int, b: int): int return a + b end
function api.add(a: int, b: int): int return a + b end
function api.handlers.add(a: int, b: int): int return a + b end
function api.deep.path.add(a: int, b: int): int return a + b end
function api.handlers:method(a: int): int return a end
local api = { handlers = {}, deep = { path = {} } }

-- 6. Tables, nested ----------------------------------------------------
local config = {
    name = "root",
    list = { 1, 2, { 3, 4, { 5, { 6 } } } },
    deep = {
        a = {
            b = {
                c = {
                    d = { value = 42, text = "x" },
                },
            },
        },
    },
    ["key with space"] = { [1] = { [2] = { [3] = true } } },
    handlers = {
        move = function(ped: int, pos: Vec3, speed: float?): bool
            return true
        end,
        nested = {
            call = function(a: int|string, b: ?string, c: { int }): table
                return {}
            end,
        },
    },
}
print(config.deep.a.b.c.d.value, config.list[3][3][2][1])

-- 7. Classes, enums, switch -------------------------------------------
class Entity
    public id: int
    protected hp: float = 100
    private secret: string?
    static count: int = 0

    function __construct(id: int)
        self.id = id
    end

    function damage(amount: float): void
        self.hp -= amount
    end

    public function get_health()
        self:health()
    end
    
    protected function set_health_only_for_animals()
        self.hp -= amount
    end

    private function health()
        return self.hp
    end

    static function make(id: int): Entity
        return new Entity(id)
    end
end

class Human extends Entity
    function __construct(id: int, name: string)
        parent.__construct(self, id)
        self.name = name
    end

    function greet(): string
        return "Hi, " .. self.name
    end
end

local human = new Human(1, "John")
print(human:greet(), human.name, Human.count)

enum Color begin
    Red,
    Green = 5,
    Blue
end
enum class Direction begin North, South end

switch human.id do
    case 1:
        print("one")
        break
    case 2, 3:
        print("two or three")
        break
    default:
        print("other")
end

