{
	"name": "pluto-lua-language-support",
	"displayName": "%displayName%",
	"description": "%description%",
	"keywords": [
		"Pluto language",
		"pluto",
		"lua",
		"intellisense",
		"diagnostics",
		"linter"
	],
	"version": "0.22.0",
	"publisher": "Lirniri",
	"icon": "icon.png",
	"repository": "https://github.com/PlutoLang/Syntax-Highlighting",
	"scripts": {
		"test": "node test.js && node test/language.test.js",
		"package": "npx --yes @vscode/vsce package",
		"gen-builtins": "node scripts/gen-builtins.js",
		"zip": "git archive --format zip --output Pluto-Syntax-Highlighting.zip main"
	},
	"engines": {
		"vscode": "^1.65.0"
	},
	"categories": [
		"Programming Languages",
		"Snippets"
	],
	"contributes": {
		"languages": [
			{
				"id": "pluto",
				"aliases": [
					"Pluto"
				],
				"extensions": [
					".pluto"
				],
				"configuration": "./language-config.json",
				"icon": {
					"light": "icon-flat.png",
					"dark": "icon-flat.png"
				}
			},
			{
				"id": "lua",
				"configuration": "./language-config-lua.json"
			}
		],
		"grammars": [
			{
				"language": "pluto",
				"scopeName": "source.pluto",
				"path": "./Pluto.tmbundle/Syntaxes/Pluto.tmLanguage"
			}
		],
		"snippets": [
			{
				"language": "pluto",
				"path": "./Pluto.tmbundle/Snippets/_vscode.code-snippets"
			},
			{
				"language": "pluto",
				"path": "./snippets/pluto.code-snippets"
			}
		],
		"commands": [
			{
				"command": "pluto-syntax-highlighting.run",
				"title": "%command.run.title%"
			},
			{
				"command": "pluto-syntax-highlighting.lint",
				"title": "%command.lint.title%"
			},
			{
				"command": "pluto-syntax-highlighting.reindex",
				"title": "%command.reindex.title%"
			},
			{
				"command": "pluto-syntax-highlighting.showDeclarations",
				"title": "%command.showDeclarations.title%"
			},
			{
				"command": "pluto-syntax-highlighting.peekCode",
				"title": "%command.peekCode.title%"
			}
		],
		"configuration": {
			"title": "%config.title%",
			"properties": {
				"pluto.language": {
					"type": "string",
					"enum": [
						"auto",
						"en",
						"ru"
					],
					"enumDescriptions": [
						"%pluto.language.enumDescriptions.0%",
						"%pluto.language.enumDescriptions.1%",
						"%pluto.language.enumDescriptions.2%"
					],
					"default": "auto",
					"markdownDescription": "%pluto.language.markdownDescription%"
				},
				"pluto.lua.enable": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%pluto.lua.enable.markdownDescription%"
				},
				"pluto.lua.indexFiles": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%pluto.lua.indexFiles.markdownDescription%"
				},
				"pluto.index.enabled": {
					"type": "boolean",
					"default": true,
					"description": "%pluto.index.enabled.description%"
				},
				"pluto.index.includeLua": {
					"type": "boolean",
					"default": true,
					"markdownDeprecationMessage": "%pluto.index.includeLua.markdownDeprecationMessage%",
					"markdownDescription": "%pluto.index.includeLua.markdownDescription%"
				},
				"pluto.index.exclude": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"scope": "resource",
					"markdownDeprecationMessage": "%pluto.index.exclude.markdownDeprecationMessage%",
					"markdownDescription": "%pluto.index.exclude.markdownDescription%"
				},
				"pluto.workspace.useGitignore": {
					"type": "boolean",
					"default": true,
					"scope": "resource",
					"markdownDescription": "%pluto.workspace.useGitignore.markdownDescription%"
				},
				"pluto.workspace.ignoreFiles": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [
						".gitignore",
						".plutoignore"
					],
					"scope": "resource",
					"markdownDescription": "%pluto.workspace.ignoreFiles.markdownDescription%"
				},
				"pluto.workspace.exclude": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"scope": "resource",
					"markdownDescription": "%pluto.workspace.exclude.markdownDescription%"
				},
				"pluto.workspace.useSearchExclude": {
					"type": "boolean",
					"default": true,
					"scope": "resource",
					"markdownDescription": "%pluto.workspace.useSearchExclude.markdownDescription%"
				},
				"pluto.index.maxFiles": {
					"type": "integer",
					"default": 5000,
					"minimum": 1,
					"description": "%pluto.index.maxFiles.description%"
				},
				"pluto.completion.keywords": {
					"type": "boolean",
					"default": true,
					"description": "%pluto.completion.keywords.description%"
				},
				"pluto.completion.documentWords": {
					"type": "boolean",
					"default": true,
					"description": "%pluto.completion.documentWords.description%"
				},
				"pluto.completion.autoTriggerTypes": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%pluto.completion.autoTriggerTypes.markdownDescription%"
				},
				"pluto.outline.showFunctionBody": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%pluto.outline.showFunctionBody.markdownDescription%"
				},
				"pluto.outline.maxFileLines": {
					"type": "integer",
					"default": 1000,
					"minimum": 0,
					"markdownDescription": "%pluto.outline.maxFileLines.markdownDescription%"
				},
				"pluto.outline.calls": {
					"type": "string",
					"enum": [
						"none",
						"statements",
						"all"
					],
					"enumDescriptions": [
						"%pluto.outline.calls.enumDescriptions.0%",
						"%pluto.outline.calls.enumDescriptions.1%",
						"%pluto.outline.calls.enumDescriptions.2%"
					],
					"default": "none",
					"markdownDescription": "%pluto.outline.calls.markdownDescription%"
				},
				"pluto.outline.localVariables": {
					"type": "boolean",
					"default": true,
					"description": "%pluto.outline.localVariables.description%"
				},
				"pluto.outline.loopVariables": {
					"type": "boolean",
					"default": false,
					"markdownDescription": "%pluto.outline.loopVariables.markdownDescription%"
				},
				"pluto.outline.parameters": {
					"type": "boolean",
					"default": false,
					"description": "%pluto.outline.parameters.description%"
				},
				"pluto.outline.anonymousFunctions": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%pluto.outline.anonymousFunctions.markdownDescription%"
				},
				"pluto.outline.fields": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%pluto.outline.fields.markdownDescription%"
				},
				"pluto.outline.showValues": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%pluto.outline.showValues.markdownDescription%"
				},
				"pluto.hover.sourcePath": {
					"type": "string",
					"enum": [
						"short",
						"relative",
						"none"
					],
					"enumDescriptions": [
						"%pluto.hover.sourcePath.enumDescriptions.0%",
						"%pluto.hover.sourcePath.enumDescriptions.1%",
						"%pluto.hover.sourcePath.enumDescriptions.2%"
					],
					"default": "short",
					"markdownDescription": "%pluto.hover.sourcePath.markdownDescription%"
				},
				"pluto.hover.showFunctionBody": {
					"type": "boolean",
					"default": true,
					"description": "%pluto.hover.showFunctionBody.description%"
				},
				"pluto.hover.maxBodyLines": {
					"type": "integer",
					"default": 25,
					"minimum": 0,
					"markdownDescription": "%pluto.hover.maxBodyLines.markdownDescription%"
				},
				"pluto.hover.maxDeclarations": {
					"type": "integer",
					"default": 8,
					"minimum": 1,
					"description": "%pluto.hover.maxDeclarations.description%"
				},
				"pluto.highlight.nullableTypes": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%pluto.highlight.nullableTypes.markdownDescription%"
				},
				"pluto.highlight.nullableTypeColor": {
					"type": "string",
					"default": "#FFFFFF",
					"markdownDescription": "%pluto.highlight.nullableTypeColor.markdownDescription%"
				},
				"pluto.highlight.nullableTypeLightColor": {
					"type": "string",
					"default": "#000000",
					"markdownDescription": "%pluto.highlight.nullableTypeLightColor.markdownDescription%"
				},
				"pluto.highlight.applyColors": {
					"type": "boolean",
					"default": false,
					"markdownDescription": "%pluto.highlight.applyColors.markdownDescription%"
				},
				"pluto.highlight.colors": {
					"type": "object",
					"default": {},
					"markdownDescription": "%pluto.highlight.colors.markdownDescription%",
					"additionalProperties": false,
					"properties": {
						"functionName": {
							"anyOf": [{ "type": "string", "format": "color-hex" }, { "type": "string", "pattern": "^\\s*#[0-9a-fA-F]{3,8}(\\s+(bold|italic|underline|strikethrough|normal|none))*\\s*$" }, { "type": "object" }],
							"markdownDescription": "%pluto.highlight.colors.functionName%",
							"properties": {
								"color": { "type": "string", "format": "color-hex", "markdownDescription": "%pluto.highlight.style.color%" },
								"fontStyle": { "type": "string", "enum": ["normal", "bold", "italic", "bold italic", "underline", "bold underline", "italic underline"], "markdownDescription": "%pluto.highlight.style.fontStyle%" }
							}
						},
						"functionKeyword": {
							"anyOf": [{ "type": "string", "format": "color-hex" }, { "type": "string", "pattern": "^\\s*#[0-9a-fA-F]{3,8}(\\s+(bold|italic|underline|strikethrough|normal|none))*\\s*$" }, { "type": "object" }],
							"markdownDescription": "%pluto.highlight.colors.functionKeyword%",
							"properties": {
								"color": { "type": "string", "format": "color-hex", "markdownDescription": "%pluto.highlight.style.color%" },
								"fontStyle": { "type": "string", "enum": ["normal", "bold", "italic", "bold italic", "underline", "bold underline", "italic underline"], "markdownDescription": "%pluto.highlight.style.fontStyle%" }
							}
						},
						"parameter": {
							"anyOf": [{ "type": "string", "format": "color-hex" }, { "type": "string", "pattern": "^\\s*#[0-9a-fA-F]{3,8}(\\s+(bold|italic|underline|strikethrough|normal|none))*\\s*$" }, { "type": "object" }],
							"markdownDescription": "%pluto.highlight.colors.parameter%",
							"properties": {
								"color": { "type": "string", "format": "color-hex", "markdownDescription": "%pluto.highlight.style.color%" },
								"fontStyle": { "type": "string", "enum": ["normal", "bold", "italic", "bold italic", "underline", "bold underline", "italic underline"], "markdownDescription": "%pluto.highlight.style.fontStyle%" }
							}
						},
						"type": {
							"anyOf": [{ "type": "string", "format": "color-hex" }, { "type": "string", "pattern": "^\\s*#[0-9a-fA-F]{3,8}(\\s+(bold|italic|underline|strikethrough|normal|none))*\\s*$" }, { "type": "object" }],
							"markdownDescription": "%pluto.highlight.colors.type%",
							"properties": {
								"color": { "type": "string", "format": "color-hex", "markdownDescription": "%pluto.highlight.style.color%" },
								"fontStyle": { "type": "string", "enum": ["normal", "bold", "italic", "bold italic", "underline", "bold underline", "italic underline"], "markdownDescription": "%pluto.highlight.style.fontStyle%" }
							}
						},
						"returnType": {
							"anyOf": [{ "type": "string", "format": "color-hex" }, { "type": "string", "pattern": "^\\s*#[0-9a-fA-F]{3,8}(\\s+(bold|italic|underline|strikethrough|normal|none))*\\s*$" }, { "type": "object" }],
							"markdownDescription": "%pluto.highlight.colors.returnType%",
							"properties": {
								"color": { "type": "string", "format": "color-hex", "markdownDescription": "%pluto.highlight.style.color%" },
								"fontStyle": { "type": "string", "enum": ["normal", "bold", "italic", "bold italic", "underline", "bold underline", "italic underline"], "markdownDescription": "%pluto.highlight.style.fontStyle%" }
							}
						},
						"typeColon": {
							"anyOf": [{ "type": "string", "format": "color-hex" }, { "type": "string", "pattern": "^\\s*#[0-9a-fA-F]{3,8}(\\s+(bold|italic|underline|strikethrough|normal|none))*\\s*$" }, { "type": "object" }],
							"markdownDescription": "%pluto.highlight.colors.typeColon%",
							"properties": {
								"color": { "type": "string", "format": "color-hex", "markdownDescription": "%pluto.highlight.style.color%" },
								"fontStyle": { "type": "string", "enum": ["normal", "bold", "italic", "bold italic", "underline", "bold underline", "italic underline"], "markdownDescription": "%pluto.highlight.style.fontStyle%" }
							}
						},
						"keyword": {
							"anyOf": [{ "type": "string", "format": "color-hex" }, { "type": "string", "pattern": "^\\s*#[0-9a-fA-F]{3,8}(\\s+(bold|italic|underline|strikethrough|normal|none))*\\s*$" }, { "type": "object" }],
							"markdownDescription": "%pluto.highlight.colors.keyword%",
							"properties": {
								"color": { "type": "string", "format": "color-hex", "markdownDescription": "%pluto.highlight.style.color%" },
								"fontStyle": { "type": "string", "enum": ["normal", "bold", "italic", "bold italic", "underline", "bold underline", "italic underline"], "markdownDescription": "%pluto.highlight.style.fontStyle%" }
							}
						},
						"operator": {
							"anyOf": [{ "type": "string", "format": "color-hex" }, { "type": "string", "pattern": "^\\s*#[0-9a-fA-F]{3,8}(\\s+(bold|italic|underline|strikethrough|normal|none))*\\s*$" }, { "type": "object" }],
							"markdownDescription": "%pluto.highlight.colors.operator%",
							"properties": {
								"color": { "type": "string", "format": "color-hex", "markdownDescription": "%pluto.highlight.style.color%" },
								"fontStyle": { "type": "string", "enum": ["normal", "bold", "italic", "bold italic", "underline", "bold underline", "italic underline"], "markdownDescription": "%pluto.highlight.style.fontStyle%" }
							}
						},
						"constant": {
							"anyOf": [{ "type": "string", "format": "color-hex" }, { "type": "string", "pattern": "^\\s*#[0-9a-fA-F]{3,8}(\\s+(bold|italic|underline|strikethrough|normal|none))*\\s*$" }, { "type": "object" }],
							"markdownDescription": "%pluto.highlight.colors.constant%",
							"properties": {
								"color": { "type": "string", "format": "color-hex", "markdownDescription": "%pluto.highlight.style.color%" },
								"fontStyle": { "type": "string", "enum": ["normal", "bold", "italic", "bold italic", "underline", "bold underline", "italic underline"], "markdownDescription": "%pluto.highlight.style.fontStyle%" }
							}
						},
						"modifier": {
							"anyOf": [{ "type": "string", "format": "color-hex" }, { "type": "string", "pattern": "^\\s*#[0-9a-fA-F]{3,8}(\\s+(bold|italic|underline|strikethrough|normal|none))*\\s*$" }, { "type": "object" }],
							"markdownDescription": "%pluto.highlight.colors.modifier%",
							"properties": {
								"color": { "type": "string", "format": "color-hex", "markdownDescription": "%pluto.highlight.style.color%" },
								"fontStyle": { "type": "string", "enum": ["normal", "bold", "italic", "bold italic", "underline", "bold underline", "italic underline"], "markdownDescription": "%pluto.highlight.style.fontStyle%" }
							}
						},
						"accessor": {
							"anyOf": [{ "type": "string", "format": "color-hex" }, { "type": "string", "pattern": "^\\s*#[0-9a-fA-F]{3,8}(\\s+(bold|italic|underline|strikethrough|normal|none))*\\s*$" }, { "type": "object" }],
							"markdownDescription": "%pluto.highlight.colors.accessor%",
							"properties": {
								"color": { "type": "string", "format": "color-hex", "markdownDescription": "%pluto.highlight.style.color%" },
								"fontStyle": { "type": "string", "enum": ["normal", "bold", "italic", "bold italic", "underline", "bold underline", "italic underline"], "markdownDescription": "%pluto.highlight.style.fontStyle%" }
							}
						}
					}
				},
				"pluto.highlight.tableBracketColors": {
					"type": "array",
					"default": [],
					"items": {
						"anyOf": [{ "type": "string", "format": "color-hex" }, { "type": "string", "pattern": "^\\s*#[0-9a-fA-F]{3,8}(\\s+(bold|italic|underline|strikethrough|normal|none))*\\s*$" }, { "type": "object" }],
						"properties": {
							"color": { "type": "string", "format": "color-hex", "markdownDescription": "%pluto.highlight.style.color%" },
							"fontStyle": { "type": "string", "enum": ["normal", "bold", "italic", "bold italic", "underline", "bold underline", "italic underline"], "markdownDescription": "%pluto.highlight.style.fontStyle%" }
						}
					},
					"markdownDescription": "%pluto.highlight.tableBracketColors.markdownDescription%"
				},
				"pluto.autoCloseBlocks": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%pluto.autoCloseBlocks.markdownDescription%"
				},
				"pluto.diagnostics.enable": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%pluto.diagnostics.enable.markdownDescription%"
				},
				"pluto.diagnostics.compilerPath": {
					"type": "string",
					"default": "",
					"scope": "machine-overridable",
					"markdownDescription": "%pluto.diagnostics.compilerPath.markdownDescription%"
				},
				"pluto.diagnostics.debounceMs": {
					"type": "number",
					"default": 400,
					"minimum": 0,
					"maximum": 10000,
					"description": "%pluto.diagnostics.debounceMs.description%"
				}
			}
		},
		"menus": {
			"commandPalette": [
				{
					"command": "pluto-syntax-highlighting.showDeclarations",
					"when": "false"
				},
				{
					"command": "pluto-syntax-highlighting.peekCode",
					"when": "false"
				}
			]
		},
		"configurationDefaults": {
			"[pluto]": {
				"editor.autoIndent": "full"
			},
			"[lua]": {
				"editor.autoIndent": "full"
			}
		}
	},
	"main": "./src/extension.js",
	"activationEvents": [
		"onLanguage:pluto",
		"onCommand:pluto-syntax-highlighting.run",
		"onCommand:pluto-syntax-highlighting.lint",
		"onCommand:pluto-syntax-highlighting.reindex",
		"workspaceContains:**/*.pluto",
		"onCommand:pluto-syntax-highlighting.showDeclarations",
		"onCommand:pluto-syntax-highlighting.peekCode"
	],
	"devDependencies": {
		"vscode-oniguruma": "^2.0.1",
		"vscode-textmate": "^9.2.0"
	},
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": "limited",
			"description": "In untrusted workspaces no Pluto compiler is run; built-in checks still work.",
			"restrictedConfigurations": [
				"pluto.diagnostics.compilerPath"
			]
		}
	}
}
