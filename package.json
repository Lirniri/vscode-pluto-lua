{
	"name": "pluto-lua-language-support",
	"displayName": "%displayName%",
	"description": "%description%",
	"keywords": [
		"Pluto language",
		"pluto",
		"lua",
		"mini-ide",
		"highlighting",
		"completion",
		"intellisense",
		"diagnostics",
		"linter",
		"settings"
	],
	"version": "0.29.2",
	"publisher": "Lirniri",
	"icon": "icon.png",
	"repository": "https://github.com/PlutoLang/Syntax-Highlighting",
	"scripts": {
		"test": "node test.js && node test/language.test.js",
		"package": "npx --yes @vscode/vsce package",
		"gen-builtins": "node scripts/gen-builtins.js",
		"zip": "git archive --format zip --output Pluto-Syntax-Highlighting.zip main"
	},
	"engines": {
		"vscode": "^1.65.0"
	},
	"categories": [
		"Programming Languages",
		"Snippets",
		"Linters"
	],
	"galleryBanner": {
		"color": "#241447",
		"theme": "dark"
	},
	"homepage": "https://github.com/Lirniri/vscode-pluto-lua#readme",
	"bugs": {
		"url": "https://github.com/Lirniri/vscode-pluto-lua/issues"
	},
	"contributes": {
		"languages": [
			{
				"id": "pluto",
				"aliases": [
					"Pluto"
				],
				"extensions": [
					".pluto"
				],
				"configuration": "./language-config.json",
				"icon": {
					"light": "icon-flat.png",
					"dark": "icon-flat.png"
				}
			},
			{
				"id": "lua",
				"configuration": "./language-config-lua.json"
			}
		],
		"grammars": [
			{
				"language": "pluto",
				"scopeName": "source.pluto",
				"path": "./Pluto.tmbundle/Syntaxes/Pluto.tmLanguage"
			}
		],
		"snippets": [
			{
				"language": "pluto",
				"path": "./Pluto.tmbundle/Snippets/_vscode.code-snippets"
			},
			{
				"language": "pluto",
				"path": "./snippets/pluto.code-snippets"
			}
		],
		"commands": [
			{
				"command": "plua.run",
				"title": "%command.run.title%"
			},
			{
				"command": "plua.lint",
				"title": "%command.lint.title%"
			},
			{
				"command": "plua.reindex",
				"title": "%command.reindex.title%"
			},
			{
				"command": "plua.showDeclarations",
				"title": "%command.showDeclarations.title%"
			},
			{
				"command": "plua.peekCode",
				"title": "%command.peekCode.title%"
			},
			{
				"command": "plua.openSettings",
				"title": "%command.openSettings.title%"
			}
		],
		"configuration": {
			"title": "%config.title%",
			"properties": {
				"pluto.language": {
					"type": "string",
					"enum": [
						"auto",
						"en",
						"ru"
					],
					"enumDescriptions": [
						"%pluto.language.enumDescriptions.0%",
						"%pluto.language.enumDescriptions.1%",
						"%pluto.language.enumDescriptions.2%"
					],
					"default": "auto",
					"markdownDescription": "%pluto.language.markdownDescription%"
				},
				"pluto.lua.enable": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%pluto.lua.enable.markdownDescription%"
				},
				"pluto.json.enable": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%pluto.json.enable.markdownDescription%"
				},
				"pluto.json.files": {
					"type": "array",
					"items": { "type": "string" },
					"default": ["**/info.json"],
					"scope": "resource",
					"markdownDescription": "%pluto.json.files.markdownDescription%"
				},
				"pluto.json.extensions": {
					"type": "array",
					"items": { "type": "string" },
					"default": [".pluto", ".lua"],
					"scope": "resource",
					"markdownDescription": "%pluto.json.extensions.markdownDescription%"
				},
				"pluto.json.checkAllPaths": {
					"type": "boolean",
					"default": false,
					"scope": "resource",
					"markdownDescription": "%pluto.json.checkAllPaths.markdownDescription%"
				},
				"pluto.json.severity": {
					"type": "string",
					"enum": ["warning", "error", "information"],
					"default": "warning",
					"markdownDescription": "%pluto.json.severity.markdownDescription%"
				},
				"pluto.json.notifyNoFolder": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%pluto.json.notifyNoFolder.markdownDescription%"
				},
				"pluto.lua.checkSyntax": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%pluto.lua.checkSyntax.markdownDescription%"
				},
				"pluto.lua.compilerPath": {
					"type": "string",
					"default": "",
					"scope": "machine-overridable",
					"markdownDescription": "%pluto.lua.compilerPath.markdownDescription%"
				},
				"pluto.lua.indexFiles": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%pluto.lua.indexFiles.markdownDescription%"
				},
				"pluto.index.enabled": {
					"type": "boolean",
					"default": true,
					"description": "%pluto.index.enabled.description%"
				},
				"pluto.index.includeLua": {
					"type": "boolean",
					"default": true,
					"markdownDeprecationMessage": "%pluto.index.includeLua.markdownDeprecationMessage%",
					"markdownDescription": "%pluto.index.includeLua.markdownDescription%"
				},
				"pluto.index.exclude": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"scope": "resource",
					"markdownDeprecationMessage": "%pluto.index.exclude.markdownDeprecationMessage%",
					"markdownDescription": "%pluto.index.exclude.markdownDescription%"
				},
				"pluto.workspace.useGitignore": {
					"type": "boolean",
					"default": true,
					"scope": "resource",
					"markdownDescription": "%pluto.workspace.useGitignore.markdownDescription%"
				},
				"pluto.workspace.ignoreFiles": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [
						".gitignore",
						".plutoignore",
						".luaignore"
					],
					"scope": "resource",
					"markdownDescription": "%pluto.workspace.ignoreFiles.markdownDescription%"
				},
				"pluto.workspace.exclude": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"scope": "resource",
					"markdownDescription": "%pluto.workspace.exclude.markdownDescription%"
				},
				"pluto.workspace.useSearchExclude": {
					"type": "boolean",
					"default": true,
					"scope": "resource",
					"markdownDescription": "%pluto.workspace.useSearchExclude.markdownDescription%"
				},
				"pluto.index.maxFiles": {
					"type": "integer",
					"default": 5000,
					"minimum": 1,
					"description": "%pluto.index.maxFiles.description%"
				},
				"pluto.completion.keywords": {
					"type": "boolean",
					"default": true,
					"description": "%pluto.completion.keywords.description%"
				},
				"pluto.completion.documentWords": {
					"type": "boolean",
					"default": true,
					"description": "%pluto.completion.documentWords.description%"
				},
				"pluto.completion.autoTriggerTypes": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%pluto.completion.autoTriggerTypes.markdownDescription%"
				},
				"pluto.outline.showFunctionBody": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%pluto.outline.showFunctionBody.markdownDescription%"
				},
				"pluto.outline.maxFileLines": {
					"type": "integer",
					"default": 1000,
					"minimum": 0,
					"markdownDescription": "%pluto.outline.maxFileLines.markdownDescription%"
				},
				"pluto.outline.calls": {
					"type": "string",
					"enum": [
						"none",
						"statements",
						"all"
					],
					"enumDescriptions": [
						"%pluto.outline.calls.enumDescriptions.0%",
						"%pluto.outline.calls.enumDescriptions.1%",
						"%pluto.outline.calls.enumDescriptions.2%"
					],
					"default": "none",
					"markdownDescription": "%pluto.outline.calls.markdownDescription%"
				},
				"pluto.outline.localVariables": {
					"type": "boolean",
					"default": true,
					"description": "%pluto.outline.localVariables.description%"
				},
				"pluto.outline.loopVariables": {
					"type": "boolean",
					"default": false,
					"markdownDescription": "%pluto.outline.loopVariables.markdownDescription%"
				},
				"pluto.outline.parameters": {
					"type": "boolean",
					"default": false,
					"description": "%pluto.outline.parameters.description%"
				},
				"pluto.outline.anonymousFunctions": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%pluto.outline.anonymousFunctions.markdownDescription%"
				},
				"pluto.outline.fields": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%pluto.outline.fields.markdownDescription%"
				},
				"pluto.outline.showValues": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%pluto.outline.showValues.markdownDescription%"
				},
				"pluto.hover.sourcePath": {
					"type": "string",
					"enum": [
						"short",
						"relative",
						"none"
					],
					"enumDescriptions": [
						"%pluto.hover.sourcePath.enumDescriptions.0%",
						"%pluto.hover.sourcePath.enumDescriptions.1%",
						"%pluto.hover.sourcePath.enumDescriptions.2%"
					],
					"default": "short",
					"markdownDescription": "%pluto.hover.sourcePath.markdownDescription%"
				},
				"pluto.hover.showFunctionBody": {
					"type": "boolean",
					"default": true,
					"description": "%pluto.hover.showFunctionBody.description%"
				},
				"pluto.hover.forPreview": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%pluto.hover.forPreview.markdownDescription%"
				},
				"pluto.hover.maxBodyLines": {
					"type": "integer",
					"default": 25,
					"minimum": 0,
					"markdownDescription": "%pluto.hover.maxBodyLines.markdownDescription%"
				},
				"pluto.hover.maxDeclarations": {
					"type": "integer",
					"default": 8,
					"minimum": 1,
					"description": "%pluto.hover.maxDeclarations.description%"
				},
				"pluto.highlight.paramNoDefault": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%pluto.highlight.paramNoDefault.markdownDescription%"
				},
				"pluto.highlight.paramNoDefaultColor": {
					"type": "string",
					"format": "color-hex",
					"default": "#E5C07B",
					"markdownDescription": "%pluto.highlight.paramNoDefaultColor.markdownDescription%"
				},
				"pluto.highlight.paramNoDefaultLightColor": {
					"type": "string",
					"format": "color-hex",
					"default": "#BF8803",
					"markdownDescription": "%pluto.highlight.paramNoDefaultLightColor.markdownDescription%"
				},
				"pluto.completion.defaultValues": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%pluto.completion.defaultValues.markdownDescription%"
				},
				"pluto.completion.defaultValuesDelayMs": {
					"type": "integer",
					"default": 800,
					"minimum": 0,
					"maximum": 10000,
					"markdownDescription": "%pluto.completion.defaultValuesDelayMs.markdownDescription%"
				},
				"pluto.highlight.paramNoType": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%pluto.highlight.paramNoType.markdownDescription%"
				},
				"pluto.highlight.caseNoColon": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%pluto.highlight.caseNoColon.markdownDescription%"
				},
				"pluto.highlight.nullableTypes": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%pluto.highlight.nullableTypes.markdownDescription%"
				},
				"pluto.highlight.nullableTypeColor": {
					"type": "string",
					"format": "color-hex",
					"default": "#FFFFFF",
					"markdownDescription": "%pluto.highlight.nullableTypeColor.markdownDescription%"
				},
				"pluto.highlight.nullableTypeLightColor": {
					"type": "string",
					"format": "color-hex",
					"default": "#000000",
					"markdownDescription": "%pluto.highlight.nullableTypeLightColor.markdownDescription%"
				},
				"pluto.highlight.applyColors": {
					"type": "boolean",
					"default": false,
					"markdownDescription": "%pluto.highlight.applyColors.markdownDescription%"
				},
				"pluto.highlight.colors": {
					"type": "object",
					"default": {},
					"markdownDescription": "%pluto.highlight.colors.markdownDescription%",
					"additionalProperties": false,
					"properties": {
						"functionName": {
							"anyOf": [{ "type": "string", "format": "color-hex" }, { "type": "string", "pattern": "^\\s*#[0-9a-fA-F]{3,8}(\\s+(bold|italic|underline|strikethrough|normal|none))*\\s*$" }, { "type": "object" }],
							"markdownDescription": "%pluto.highlight.colors.functionName%",
							"properties": {
								"color": { "type": "string", "format": "color-hex", "markdownDescription": "%pluto.highlight.style.color%" },
								"darkColor": { "type": "string", "format": "color-hex", "markdownDescription": "%pluto.highlight.style.darkColor%" },
								"lightColor": { "type": "string", "format": "color-hex", "markdownDescription": "%pluto.highlight.style.lightColor%" },
								"fontStyle": { "type": "string", "enum": ["normal", "bold", "italic", "bold italic", "underline", "bold underline", "italic underline"], "markdownDescription": "%pluto.highlight.style.fontStyle%" }
							}
						},
						"functionKeyword": {
							"anyOf": [{ "type": "string", "format": "color-hex" }, { "type": "string", "pattern": "^\\s*#[0-9a-fA-F]{3,8}(\\s+(bold|italic|underline|strikethrough|normal|none))*\\s*$" }, { "type": "object" }],
							"markdownDescription": "%pluto.highlight.colors.functionKeyword%",
							"properties": {
								"color": { "type": "string", "format": "color-hex", "markdownDescription": "%pluto.highlight.style.color%" },
								"darkColor": { "type": "string", "format": "color-hex", "markdownDescription": "%pluto.highlight.style.darkColor%" },
								"lightColor": { "type": "string", "format": "color-hex", "markdownDescription": "%pluto.highlight.style.lightColor%" },
								"fontStyle": { "type": "string", "enum": ["normal", "bold", "italic", "bold italic", "underline", "bold underline", "italic underline"], "markdownDescription": "%pluto.highlight.style.fontStyle%" }
							}
						},
						"parameter": {
							"anyOf": [{ "type": "string", "format": "color-hex" }, { "type": "string", "pattern": "^\\s*#[0-9a-fA-F]{3,8}(\\s+(bold|italic|underline|strikethrough|normal|none))*\\s*$" }, { "type": "object" }],
							"markdownDescription": "%pluto.highlight.colors.parameter%",
							"properties": {
								"color": { "type": "string", "format": "color-hex", "markdownDescription": "%pluto.highlight.style.color%" },
								"darkColor": { "type": "string", "format": "color-hex", "markdownDescription": "%pluto.highlight.style.darkColor%" },
								"lightColor": { "type": "string", "format": "color-hex", "markdownDescription": "%pluto.highlight.style.lightColor%" },
								"fontStyle": { "type": "string", "enum": ["normal", "bold", "italic", "bold italic", "underline", "bold underline", "italic underline"], "markdownDescription": "%pluto.highlight.style.fontStyle%" }
							}
						},
						"type": {
							"anyOf": [{ "type": "string", "format": "color-hex" }, { "type": "string", "pattern": "^\\s*#[0-9a-fA-F]{3,8}(\\s+(bold|italic|underline|strikethrough|normal|none))*\\s*$" }, { "type": "object" }],
							"markdownDescription": "%pluto.highlight.colors.type%",
							"properties": {
								"color": { "type": "string", "format": "color-hex", "markdownDescription": "%pluto.highlight.style.color%" },
								"darkColor": { "type": "string", "format": "color-hex", "markdownDescription": "%pluto.highlight.style.darkColor%" },
								"lightColor": { "type": "string", "format": "color-hex", "markdownDescription": "%pluto.highlight.style.lightColor%" },
								"fontStyle": { "type": "string", "enum": ["normal", "bold", "italic", "bold italic", "underline", "bold underline", "italic underline"], "markdownDescription": "%pluto.highlight.style.fontStyle%" }
							}
						},
						"returnType": {
							"anyOf": [{ "type": "string", "format": "color-hex" }, { "type": "string", "pattern": "^\\s*#[0-9a-fA-F]{3,8}(\\s+(bold|italic|underline|strikethrough|normal|none))*\\s*$" }, { "type": "object" }],
							"markdownDescription": "%pluto.highlight.colors.returnType%",
							"properties": {
								"color": { "type": "string", "format": "color-hex", "markdownDescription": "%pluto.highlight.style.color%" },
								"darkColor": { "type": "string", "format": "color-hex", "markdownDescription": "%pluto.highlight.style.darkColor%" },
								"lightColor": { "type": "string", "format": "color-hex", "markdownDescription": "%pluto.highlight.style.lightColor%" },
								"fontStyle": { "type": "string", "enum": ["normal", "bold", "italic", "bold italic", "underline", "bold underline", "italic underline"], "markdownDescription": "%pluto.highlight.style.fontStyle%" }
							}
						},
						"typeColon": {
							"anyOf": [{ "type": "string", "format": "color-hex" }, { "type": "string", "pattern": "^\\s*#[0-9a-fA-F]{3,8}(\\s+(bold|italic|underline|strikethrough|normal|none))*\\s*$" }, { "type": "object" }],
							"markdownDescription": "%pluto.highlight.colors.typeColon%",
							"properties": {
								"color": { "type": "string", "format": "color-hex", "markdownDescription": "%pluto.highlight.style.color%" },
								"darkColor": { "type": "string", "format": "color-hex", "markdownDescription": "%pluto.highlight.style.darkColor%" },
								"lightColor": { "type": "string", "format": "color-hex", "markdownDescription": "%pluto.highlight.style.lightColor%" },
								"fontStyle": { "type": "string", "enum": ["normal", "bold", "italic", "bold italic", "underline", "bold underline", "italic underline"], "markdownDescription": "%pluto.highlight.style.fontStyle%" }
							}
						},
						"keyword": {
							"anyOf": [{ "type": "string", "format": "color-hex" }, { "type": "string", "pattern": "^\\s*#[0-9a-fA-F]{3,8}(\\s+(bold|italic|underline|strikethrough|normal|none))*\\s*$" }, { "type": "object" }],
							"markdownDescription": "%pluto.highlight.colors.keyword%",
							"properties": {
								"color": { "type": "string", "format": "color-hex", "markdownDescription": "%pluto.highlight.style.color%" },
								"darkColor": { "type": "string", "format": "color-hex", "markdownDescription": "%pluto.highlight.style.darkColor%" },
								"lightColor": { "type": "string", "format": "color-hex", "markdownDescription": "%pluto.highlight.style.lightColor%" },
								"fontStyle": { "type": "string", "enum": ["normal", "bold", "italic", "bold italic", "underline", "bold underline", "italic underline"], "markdownDescription": "%pluto.highlight.style.fontStyle%" }
							}
						},
						"operator": {
							"anyOf": [{ "type": "string", "format": "color-hex" }, { "type": "string", "pattern": "^\\s*#[0-9a-fA-F]{3,8}(\\s+(bold|italic|underline|strikethrough|normal|none))*\\s*$" }, { "type": "object" }],
							"markdownDescription": "%pluto.highlight.colors.operator%",
							"properties": {
								"color": { "type": "string", "format": "color-hex", "markdownDescription": "%pluto.highlight.style.color%" },
								"darkColor": { "type": "string", "format": "color-hex", "markdownDescription": "%pluto.highlight.style.darkColor%" },
								"lightColor": { "type": "string", "format": "color-hex", "markdownDescription": "%pluto.highlight.style.lightColor%" },
								"fontStyle": { "type": "string", "enum": ["normal", "bold", "italic", "bold italic", "underline", "bold underline", "italic underline"], "markdownDescription": "%pluto.highlight.style.fontStyle%" }
							}
						},
						"constant": {
							"anyOf": [{ "type": "string", "format": "color-hex" }, { "type": "string", "pattern": "^\\s*#[0-9a-fA-F]{3,8}(\\s+(bold|italic|underline|strikethrough|normal|none))*\\s*$" }, { "type": "object" }],
							"markdownDescription": "%pluto.highlight.colors.constant%",
							"properties": {
								"color": { "type": "string", "format": "color-hex", "markdownDescription": "%pluto.highlight.style.color%" },
								"darkColor": { "type": "string", "format": "color-hex", "markdownDescription": "%pluto.highlight.style.darkColor%" },
								"lightColor": { "type": "string", "format": "color-hex", "markdownDescription": "%pluto.highlight.style.lightColor%" },
								"fontStyle": { "type": "string", "enum": ["normal", "bold", "italic", "bold italic", "underline", "bold underline", "italic underline"], "markdownDescription": "%pluto.highlight.style.fontStyle%" }
							}
						},
						"modifier": {
							"anyOf": [{ "type": "string", "format": "color-hex" }, { "type": "string", "pattern": "^\\s*#[0-9a-fA-F]{3,8}(\\s+(bold|italic|underline|strikethrough|normal|none))*\\s*$" }, { "type": "object" }],
							"markdownDescription": "%pluto.highlight.colors.modifier%",
							"properties": {
								"color": { "type": "string", "format": "color-hex", "markdownDescription": "%pluto.highlight.style.color%" },
								"darkColor": { "type": "string", "format": "color-hex", "markdownDescription": "%pluto.highlight.style.darkColor%" },
								"lightColor": { "type": "string", "format": "color-hex", "markdownDescription": "%pluto.highlight.style.lightColor%" },
								"fontStyle": { "type": "string", "enum": ["normal", "bold", "italic", "bold italic", "underline", "bold underline", "italic underline"], "markdownDescription": "%pluto.highlight.style.fontStyle%" }
							}
						},
						"accessor": {
							"anyOf": [{ "type": "string", "format": "color-hex" }, { "type": "string", "pattern": "^\\s*#[0-9a-fA-F]{3,8}(\\s+(bold|italic|underline|strikethrough|normal|none))*\\s*$" }, { "type": "object" }],
							"markdownDescription": "%pluto.highlight.colors.accessor%",
							"properties": {
								"color": { "type": "string", "format": "color-hex", "markdownDescription": "%pluto.highlight.style.color%" },
								"darkColor": { "type": "string", "format": "color-hex", "markdownDescription": "%pluto.highlight.style.darkColor%" },
								"lightColor": { "type": "string", "format": "color-hex", "markdownDescription": "%pluto.highlight.style.lightColor%" },
								"fontStyle": { "type": "string", "enum": ["normal", "bold", "italic", "bold italic", "underline", "bold underline", "italic underline"], "markdownDescription": "%pluto.highlight.style.fontStyle%" }
							}
						}
					}
				},
				"pluto.highlight.tableBracketColors": {
					"type": "array",
					"default": [],
					"items": {
						"anyOf": [{ "type": "string", "format": "color-hex" }, { "type": "string", "pattern": "^\\s*#[0-9a-fA-F]{3,8}(\\s+(bold|italic|underline|strikethrough|normal|none))*\\s*$" }, { "type": "object" }],
						"properties": {
							"color": { "type": "string", "format": "color-hex", "markdownDescription": "%pluto.highlight.style.color%" },
							"darkColor": { "type": "string", "format": "color-hex", "markdownDescription": "%pluto.highlight.style.darkColor%" },
							"lightColor": { "type": "string", "format": "color-hex", "markdownDescription": "%pluto.highlight.style.lightColor%" },
							"fontStyle": { "type": "string", "enum": ["normal", "bold", "italic", "bold italic", "underline", "bold underline", "italic underline"], "markdownDescription": "%pluto.highlight.style.fontStyle%" }
						}
					},
					"markdownDescription": "%pluto.highlight.tableBracketColors.markdownDescription%"
				},
				"pluto.format.newLineAfterComma": {
					"type": "boolean",
					"default": true,
					"scope": "resource",
					"markdownDescription": "%pluto.format.newLineAfterComma.markdownDescription%"
				},
				"pluto.format.newLineAfterCommaDelayMs": {
					"type": "integer",
					"default": 700,
					"minimum": 0,
					"maximum": 10000,
					"markdownDescription": "%pluto.format.newLineAfterCommaDelayMs.markdownDescription%"
				},
				"pluto.format.ifBlockWord": {
					"type": "string",
					"enum": ["auto", "then", "do", "off"],
					"default": "auto",
					"enumDescriptions": [
						"%pluto.format.ifBlockWord.auto%",
						"%pluto.format.ifBlockWord.then%",
						"%pluto.format.ifBlockWord.do%",
						"%pluto.format.ifBlockWord.off%"
					],
					"markdownDescription": "%pluto.format.ifBlockWord.markdownDescription%"
				},
				"pluto.format.suggestFor": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%pluto.format.suggestFor.markdownDescription%"
				},
				"pluto.format.nameStyle": {
					"type": "string",
					"enum": ["short", "full"],
					"default": "short",
					"enumDescriptions": [
						"%pluto.format.nameStyle.short%",
						"%pluto.format.nameStyle.full%"
					],
					"markdownDescription": "%pluto.format.nameStyle.markdownDescription%"
				},
				"pluto.format.names": {
					"type": "object",
					"default": {},
					"additionalProperties": false,
					"properties": {
						"index": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
						"key": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
						"value": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
						"table": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
					},
					"markdownDescription": "%pluto.format.names.markdownDescription%"
				},
				"pluto.format.suggestParamType": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%pluto.format.suggestParamType.markdownDescription%"
				},
				"pluto.format.suggestParamTypeDelayMs": {
					"type": "integer",
					"default": 600,
					"minimum": 0,
					"maximum": 10000,
					"markdownDescription": "%pluto.format.suggestParamTypeDelayMs.markdownDescription%"
				},
				"pluto.format.suggestReturnType": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%pluto.format.suggestReturnType.markdownDescription%"
				},
				"pluto.format.suggestReturnValue": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%pluto.format.suggestReturnValue.markdownDescription%"
				},
				"pluto.format.suggestCaseColon": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%pluto.format.suggestCaseColon.markdownDescription%"
				},
				"pluto.format.suggestCaseBreak": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%pluto.format.suggestCaseBreak.markdownDescription%"
				},
				"pluto.format.suggestCaseWords": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%pluto.format.suggestCaseWords.markdownDescription%"
				},
				"pluto.format.suggestConstructor": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%pluto.format.suggestConstructor.markdownDescription%"
				},
				"pluto.format.suggestParens": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%pluto.format.suggestParens.markdownDescription%"
				},
				"pluto.format.suggestTableKeyAssign": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%pluto.format.suggestTableKeyAssign.markdownDescription%"
				},
				"pluto.format.suggestBlockWords": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%pluto.format.suggestBlockWords.markdownDescription%"
				},
				"pluto.format.fixMismatchedBrackets": {
					"type": "string",
					"enum": ["off", "suggest", "auto"],
					"default": "suggest",
					"enumDescriptions": [
						"%pluto.format.fixMismatchedBrackets.off%",
						"%pluto.format.fixMismatchedBrackets.suggest%",
						"%pluto.format.fixMismatchedBrackets.auto%"
					],
					"markdownDescription": "%pluto.format.fixMismatchedBrackets.markdownDescription%"
				},
				"pluto.format.fixMismatchedBracketsDelayMs": {
					"type": "integer",
					"default": 1200,
					"minimum": 0,
					"maximum": 10000,
					"markdownDescription": "%pluto.format.fixMismatchedBracketsDelayMs.markdownDescription%"
				},
				"pluto.diagnostics.returnTypes": {
					"type": "string",
					"enum": ["warning", "error", "off"],
					"default": "warning",
					"markdownDescription": "%pluto.diagnostics.returnTypes.markdownDescription%"
				},
				"pluto.diagnostics.caseFallthrough": {
					"type": "string",
					"enum": ["off", "hint"],
					"default": "off",
					"markdownDescription": "%pluto.diagnostics.caseFallthrough.markdownDescription%"
				},
				"pluto.diagnostics.duplicateParams": {
					"type": "string",
					"enum": ["warning", "error", "off"],
					"default": "warning",
					"markdownDescription": "%pluto.diagnostics.duplicateParams.markdownDescription%"
				},
				"pluto.format.multilineParams": {
					"type": "boolean",
					"default": true,
					"scope": "resource",
					"markdownDescription": "%pluto.format.multilineParams.markdownDescription%"
				},
				"pluto.format.multilineTables": {
					"type": "boolean",
					"default": true,
					"scope": "resource",
					"markdownDescription": "%pluto.format.multilineTables.markdownDescription%"
				},
				"pluto.autoCloseBlocks": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%pluto.autoCloseBlocks.markdownDescription%"
				},
				"pluto.diagnostics.enable": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%pluto.diagnostics.enable.markdownDescription%"
				},
				"pluto.diagnostics.compilerPath": {
					"type": "string",
					"default": "",
					"scope": "machine-overridable",
					"markdownDescription": "%pluto.diagnostics.compilerPath.markdownDescription%"
				},
				"pluto.diagnostics.debounceMs": {
					"type": "number",
					"default": 400,
					"minimum": 0,
					"maximum": 10000,
					"description": "%pluto.diagnostics.debounceMs.description%"
				}
			}
		},
		"menus": {
			"commandPalette": [
				{
					"command": "plua.showDeclarations",
					"when": "false"
				},
				{
					"command": "plua.peekCode",
					"when": "false"
				}
			]
		},
		"configurationDefaults": {
			"[pluto]": {
				"editor.autoIndent": "full"
			},
			"[lua]": {
				"editor.autoIndent": "full"
			}
		}
	},
	"main": "./src/extension.js",
	"activationEvents": [
		"onLanguage:pluto",
		"onCommand:plua.run",
		"onCommand:plua.lint",
		"onCommand:plua.reindex",
		"workspaceContains:**/*.pluto",
		"onCommand:plua.showDeclarations",
		"onCommand:plua.peekCode",
		"onCommand:plua.openSettings"
	],
	"devDependencies": {
		"vscode-oniguruma": "^2.0.1",
		"vscode-textmate": "^9.2.0"
	},
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": "limited",
			"description": "In untrusted workspaces no Pluto compiler is run; built-in checks still work.",
			"restrictedConfigurations": [
				"pluto.diagnostics.compilerPath"
			]
		}
	}
}
