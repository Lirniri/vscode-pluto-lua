{
	"name": "pluto-lua-language-support",
	"displayName": "%displayName%",
	"description": "%description%",
	"keywords": [
		"Pluto language",
		"pluto",
		"lua",
		"mini-ide",
		"highlighting",
		"completion",
		"intellisense",
		"diagnostics",
		"linter",
		"settings"
	],
	"version": "0.19.0",
	"publisher": "Lirniri",
	"icon": "icon.png",
	"repository": "https://github.com/PlutoLang/Syntax-Highlighting",
	"scripts": {
		"test": "node test.js && node test/language.test.js",
		"package": "npx --yes @vscode/vsce package",
		"gen-builtins": "node scripts/gen-builtins.js",
		"zip": "git archive --format zip --output Pluto-Syntax-Highlighting.zip main"
	},
	"engines": {
		"vscode": "^1.65.0"
	},
	"categories": [
		"Programming Languages",
		"Snippets",
		"Linters"
	],
	"galleryBanner": {
		"color": "#241447",
		"theme": "dark"
	},
	"homepage": "https://github.com/Lirniri/vscode-pluto-lua#readme",
	"bugs": {
		"url": "https://github.com/Lirniri/vscode-pluto-lua/issues"
	},
	"contributes": {
		"languages": [
			{
				"id": "pluto",
				"aliases": [
					"Pluto"
				],
				"extensions": [
					".pluto"
				],
				"configuration": "./language-config.json",
				"icon": {
					"light": "icon-flat.png",
					"dark": "icon-flat.png"
				}
			},
			{
				"id": "lua",
				"configuration": "./language-config-lua.json"
			}
		],
		"grammars": [
			{
				"language": "pluto",
				"scopeName": "source.pluto",
				"path": "./Pluto.tmbundle/Syntaxes/Pluto.tmLanguage"
			}
		],
		"snippets": [
			{
				"language": "pluto",
				"path": "./Pluto.tmbundle/Snippets/_vscode.code-snippets"
			},
			{
				"language": "pluto",
				"path": "./snippets/pluto.code-snippets"
			}
		],
		"commands": [
			{
				"command": "plua.run",
				"title": "%command.run.title%"
			},
			{
				"command": "plua.lint",
				"title": "%command.lint.title%"
			},
			{
				"command": "plua.reindex",
				"title": "%command.reindex.title%"
			},
			{
				"command": "plua.showDeclarations",
				"title": "%command.showDeclarations.title%"
			},
			{
				"command": "plua.peekCode",
				"title": "%command.peekCode.title%"
			},
			{
				"command": "plua.openSettings",
				"title": "%command.openSettings.title%"
			},
			{
				"command": "plua.renameClass",
				"title": "%command.renameClass.title%"
			},
			{
				"command": "plua.convertLayout",
				"title": "%command.convertLayout.title%"
			}
		],
		"keybindings": [
			{
				"command": "plua.renameClass",
				"key": "f2",
				"when": "editorTextFocus && !editorReadonly && editorLangId == pluto"
			},
			{
				"command": "plua.smartBackspace",
				"key": "backspace",
				"when": "editorTextFocus && !editorReadonly && !editorHasSelection && !editorHasMultipleSelections && (editorLangId == pluto || editorLangId == lua && config.plua.lua.enable)"
			},
			{
				"command": "plua.smartDelete",
				"key": "delete",
				"when": "editorTextFocus && !editorReadonly && !editorHasSelection && !editorHasMultipleSelections && (editorLangId == pluto || editorLangId == lua && config.plua.lua.enable)"
			},
			{
				"command": "plua.deleteFromBelow",
				"key": "shift+backspace",
				"when": "editorTextFocus && !editorReadonly"
			},
			{
				"command": "plua.liveDirectives.dismiss",
				"key": "escape",
				"when": "editorTextFocus && plua.onDirectiveLine && !suggestWidgetVisible && !editorHasSelection && !inSnippetMode && !findWidgetVisible && !parameterHintsVisible"
			},
			{
				"command": "plua.idle.key",
				"key": "ctrl+space",
				"args": ["editor.action.triggerSuggest", "hold"],
				"when": "editorTextFocus && plua.idleArmed"
			},
			{
				"command": "plua.idle.key",
				"key": "ctrl+shift+space",
				"args": ["editor.action.triggerParameterHints", "hold"],
				"when": "editorTextFocus && plua.idleArmed"
			},
			{
				"command": "plua.idle.key",
				"key": "down",
				"args": ["selectNextSuggestion", "hold"],
				"when": "suggestWidgetVisible && textInputFocus && plua.idleArmed"
			},
			{
				"command": "plua.idle.key",
				"key": "up",
				"args": ["selectPrevSuggestion", "hold"],
				"when": "suggestWidgetVisible && textInputFocus && plua.idleArmed"
			},
			{
				"command": "plua.idle.key",
				"key": "pagedown",
				"args": ["selectNextPageSuggestion", "hold"],
				"when": "suggestWidgetVisible && textInputFocus && plua.idleArmed"
			},
			{
				"command": "plua.idle.key",
				"key": "pageup",
				"args": ["selectPrevPageSuggestion", "hold"],
				"when": "suggestWidgetVisible && textInputFocus && plua.idleArmed"
			},
			{
				"command": "plua.idle.key",
				"key": "escape",
				"args": ["hideSuggestWidget", "release"],
				"when": "suggestWidgetVisible && textInputFocus && plua.idleArmed"
			},
			{
				"command": "plua.idle.key",
				"key": "enter",
				"args": ["acceptSelectedSuggestion", "release"],
				"when": "acceptSuggestionOnEnter && suggestWidgetHasFocusedSuggestion && suggestWidgetVisible && textInputFocus && plua.idleArmed"
			},
			{
				"command": "plua.idle.key",
				"key": "tab",
				"args": ["acceptSelectedSuggestion", "release"],
				"when": "suggestWidgetHasFocusedSuggestion && suggestWidgetVisible && textInputFocus && plua.idleArmed"
			},
			{
				"command": "plua.idle.key",
				"key": "down",
				"args": ["showNextParameterHint", "hold"],
				"when": "editorTextFocus && parameterHintsVisible && plua.idleArmed && parameterHintsMultipleSignatures && !suggestWidgetVisible"
			},
			{
				"command": "plua.idle.key",
				"key": "up",
				"args": ["showPrevParameterHint", "hold"],
				"when": "editorTextFocus && parameterHintsVisible && plua.idleArmed && parameterHintsMultipleSignatures && !suggestWidgetVisible"
			},
			{
				"command": "plua.idle.key",
				"key": "escape",
				"args": ["closeParameterHints", "release"],
				"when": "editorTextFocus && parameterHintsVisible && plua.idleArmed && !suggestWidgetVisible"
			},
			{
				"command": "plua.shiftDelete",
				"key": "shift+delete",
				"when": "editorTextFocus && !editorReadonly && !editorHasSelection && !editorHasMultipleSelections && (editorLangId == pluto || editorLangId == lua && config.plua.lua.enable)"
			}
		],
		"configuration": {
			"title": "%config.title%",
			"properties": {
				"plua.language": {
					"type": "string",
					"enum": [
						"auto",
						"en",
						"ru"
					],
					"enumDescriptions": [
						"%plua.language.enumDescriptions.0%",
						"%plua.language.enumDescriptions.1%",
						"%plua.language.enumDescriptions.2%"
					],
					"default": "auto",
					"markdownDescription": "%plua.language.markdownDescription%"
				},
				"plua.lua.enable": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%plua.lua.enable.markdownDescription%"
				},
				"plua.autoIndent.enabled": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%plua.autoIndent.enabled.markdownDescription%"
				},
				"plua.autoIndent.preserveEmptyLines": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%plua.autoIndent.preserveEmptyLines.markdownDescription%"
				},
				"plua.autoIndent.indentAfterCase": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%plua.autoIndent.indentAfterCase.markdownDescription%"
				},
				"plua.autoIndent.trimOnSave": {
					"type": "boolean",
					"default": false,
					"markdownDescription": "%plua.autoIndent.trimOnSave.markdownDescription%"
				},
				"plua.liveDirectives.enabled": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%plua.liveDirectives.enabled.markdownDescription%"
				},
				"plua.liveDirectives.maxPreviewLength": {
					"type": "integer",
					"default": 60,
					"minimum": 10,
					"maximum": 500,
					"markdownDescription": "%plua.liveDirectives.maxPreviewLength.markdownDescription%"
				},
				"plua.liveDirectives.maxContextLines": {
					"type": "integer",
					"default": 3,
					"minimum": 1,
					"maximum": 30,
					"markdownDescription": "%plua.liveDirectives.maxContextLines.markdownDescription%"
				},
				"plua.liveDirectives.maxSearchDistance": {
					"type": "integer",
					"default": 200,
					"minimum": 5,
					"maximum": 5000,
					"markdownDescription": "%plua.liveDirectives.maxSearchDistance.markdownDescription%"
				},
				"plua.liveDirectives.allowModify": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%plua.liveDirectives.allowModify.markdownDescription%"
				},
				"plua.liveDirectives.skipConst": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%plua.liveDirectives.skipConst.markdownDescription%"
				},
				"plua.liveDirectives.ignoredTargets": {
					"type": "array",
					"items": { "type": "string" },
					"default": [],
					"markdownDescription": "%plua.liveDirectives.ignoredTargets.markdownDescription%"
				},
				"plua.liveDirectives.prefix": {
					"type": "string",
					"default": "#",
					"maxLength": 3,
					"markdownDescription": "%plua.liveDirectives.prefix.markdownDescription%"
				},
				"plua.liveDirectives.commandSeparator": {
					"type": "string",
					"default": ">",
					"maxLength": 4,
					"markdownDescription": "%plua.liveDirectives.commandSeparator.markdownDescription%"
				},
				"plua.liveDirectives.commandAliases": {
					"type": "object",
					"additionalProperties": { "type": "string", "enum": ["show_up", "show_down", "show_all", "type", "sign", "trace", "rename", "const", "unused", "calls"] },
					"default": {},
					"markdownDescription": "%plua.liveDirectives.commandAliases.markdownDescription%"
				},
				"plua.liveDirectives.completion": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%plua.liveDirectives.completion.markdownDescription%"
				},
				"plua.liveDirectives.inComments": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%plua.liveDirectives.inComments.markdownDescription%"
				},
				"plua.returnHelper.removeReturnWhenTypeMissing": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%plua.returnHelper.removeReturnWhenTypeMissing.markdownDescription%"
				},
				"plua.returnHelper.moveCursorToReturnOnIdle": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%plua.returnHelper.moveCursorToReturnOnIdle.markdownDescription%"
				},
				"plua.returnHelper.idleDelayMs": {
					"type": "integer",
					"default": 2000,
					"minimum": 200,
					"maximum": 60000,
					"markdownDescription": "%plua.returnHelper.idleDelayMs.markdownDescription%"
				},
				"plua.returnHelper.enableReturnDirective": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%plua.returnHelper.enableReturnDirective.markdownDescription%"
				},
				"plua.layoutFixer.enabled": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%plua.layoutFixer.enabled.markdownDescription%"
				},
				"plua.layoutFixer.mode": {
					"type": "string",
					"enum": ["live", "allCodeWords", "keywordsOnly", "off"],
					"enumDescriptions": [
						"%plua.layoutFixer.mode.enumDescriptions.0%",
						"%plua.layoutFixer.mode.enumDescriptions.1%",
						"%plua.layoutFixer.mode.enumDescriptions.2%",
						"%plua.layoutFixer.mode.enumDescriptions.3%"
					],
					"default": "live",
					"markdownDescription": "%plua.layoutFixer.mode.markdownDescription%"
				},
				"plua.layoutFixer.baseKeyboardProfile": {
					"type": "string",
					"enum": ["physicalQwerty", "hybridSmart", "keepLocalPunctuation"],
					"enumDescriptions": [
						"%plua.layoutFixer.baseKeyboardProfile.enumDescriptions.0%",
						"%plua.layoutFixer.baseKeyboardProfile.enumDescriptions.1%",
						"%plua.layoutFixer.baseKeyboardProfile.enumDescriptions.2%"
					],
					"default": "physicalQwerty",
					"markdownDescription": "%plua.layoutFixer.baseKeyboardProfile.markdownDescription%"
				},
				"plua.layoutFixer.sourceLayouts": {
					"type": "array",
					"items": { "type": "string", "enum": ["ru", "uk", "be"] },
					"default": ["ru"],
					"markdownDescription": "%plua.layoutFixer.sourceLayouts.markdownDescription%"
				},
				"plua.layoutFixer.ignoreComments": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%plua.layoutFixer.ignoreComments.markdownDescription%"
				},
				"plua.layoutFixer.ignoreStrings": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%plua.layoutFixer.ignoreStrings.markdownDescription%"
				},
				"plua.layoutFixer.autoCloseCyrillicQuotes": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%plua.layoutFixer.autoCloseCyrillicQuotes.markdownDescription%"
				},
				"plua.layoutFixer.customMap": {
					"type": "object",
					"additionalProperties": { "type": "string" },
					"default": {},
					"markdownDescription": "%plua.layoutFixer.customMap.markdownDescription%"
				},
				"plua.json.enable": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%plua.json.enable.markdownDescription%"
				},
				"plua.json.files": {
					"type": "array",
					"items": { "type": "string" },
					"default": ["**/info.json"],
					"scope": "resource",
					"markdownDescription": "%plua.json.files.markdownDescription%"
				},
				"plua.json.extensions": {
					"type": "array",
					"items": { "type": "string" },
					"default": [".pluto", ".lua"],
					"scope": "resource",
					"markdownDescription": "%plua.json.extensions.markdownDescription%"
				},
				"plua.json.checkAllPaths": {
					"type": "boolean",
					"default": false,
					"scope": "resource",
					"markdownDescription": "%plua.json.checkAllPaths.markdownDescription%"
				},
				"plua.json.severity": {
					"type": "string",
					"enum": ["warning", "error", "information"],
					"default": "warning",
					"markdownDescription": "%plua.json.severity.markdownDescription%"
				},
				"plua.json.notifyNoFolder": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%plua.json.notifyNoFolder.markdownDescription%"
				},
				"plua.lua.checkSyntax": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%plua.lua.checkSyntax.markdownDescription%"
				},
				"plua.lua.compilerPath": {
					"type": "string",
					"default": "",
					"scope": "machine-overridable",
					"markdownDescription": "%plua.lua.compilerPath.markdownDescription%"
				},
				"plua.compilers.list": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"language": { "type": "string", "enum": ["pluto", "lua"] },
							"path": { "type": "string" }
						},
						"required": ["language", "path"],
						"additionalProperties": false
					},
					"default": [],
					"scope": "machine",
					"markdownDescription": "%plua.compilers.list.markdownDescription%"
				},
				"plua.lua.indexFiles": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%plua.lua.indexFiles.markdownDescription%"
				},
				"plua.index.enabled": {
					"type": "boolean",
					"default": true,
					"description": "%plua.index.enabled.description%"
				},
				"plua.index.includeLua": {
					"type": "boolean",
					"default": true,
					"markdownDeprecationMessage": "%plua.index.includeLua.markdownDeprecationMessage%",
					"markdownDescription": "%plua.index.includeLua.markdownDescription%"
				},
				"plua.index.exclude": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"scope": "resource",
					"markdownDeprecationMessage": "%plua.index.exclude.markdownDeprecationMessage%",
					"markdownDescription": "%plua.index.exclude.markdownDescription%"
				},
				"plua.workspace.useGitignore": {
					"type": "boolean",
					"default": true,
					"scope": "resource",
					"markdownDescription": "%plua.workspace.useGitignore.markdownDescription%"
				},
				"plua.workspace.ignoreFiles": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [
						".gitignore",
						".plutoignore",
						".luaignore"
					],
					"scope": "resource",
					"markdownDescription": "%plua.workspace.ignoreFiles.markdownDescription%"
				},
				"plua.workspace.exclude": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"scope": "resource",
					"markdownDescription": "%plua.workspace.exclude.markdownDescription%"
				},
				"plua.workspace.useSearchExclude": {
					"type": "boolean",
					"default": true,
					"scope": "resource",
					"markdownDescription": "%plua.workspace.useSearchExclude.markdownDescription%"
				},
				"plua.index.maxFiles": {
					"type": "integer",
					"default": 5000,
					"minimum": 1,
					"description": "%plua.index.maxFiles.description%"
				},
				"plua.completion.keywords": {
					"type": "boolean",
					"default": true,
					"description": "%plua.completion.keywords.description%"
				},
				"plua.completion.documentWords": {
					"type": "boolean",
					"default": true,
					"description": "%plua.completion.documentWords.description%"
				},
				"plua.completion.autoTriggerTypes": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%plua.completion.autoTriggerTypes.markdownDescription%"
				},
				"plua.outline.showFunctionBody": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%plua.outline.showFunctionBody.markdownDescription%"
				},
				"plua.outline.maxFileLines": {
					"type": "integer",
					"default": 1000,
					"minimum": 0,
					"markdownDescription": "%plua.outline.maxFileLines.markdownDescription%"
				},
				"plua.outline.calls": {
					"type": "string",
					"enum": [
						"none",
						"statements",
						"all"
					],
					"enumDescriptions": [
						"%plua.outline.calls.enumDescriptions.0%",
						"%plua.outline.calls.enumDescriptions.1%",
						"%plua.outline.calls.enumDescriptions.2%"
					],
					"default": "none",
					"markdownDescription": "%plua.outline.calls.markdownDescription%"
				},
				"plua.outline.localVariables": {
					"type": "boolean",
					"default": true,
					"description": "%plua.outline.localVariables.description%"
				},
				"plua.outline.loopVariables": {
					"type": "boolean",
					"default": false,
					"markdownDescription": "%plua.outline.loopVariables.markdownDescription%"
				},
				"plua.outline.parameters": {
					"type": "boolean",
					"default": false,
					"description": "%plua.outline.parameters.description%"
				},
				"plua.outline.anonymousFunctions": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%plua.outline.anonymousFunctions.markdownDescription%"
				},
				"plua.outline.fields": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%plua.outline.fields.markdownDescription%"
				},
				"plua.outline.showValues": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%plua.outline.showValues.markdownDescription%"
				},
				"plua.hover.sourcePath": {
					"type": "string",
					"enum": [
						"short",
						"relative",
						"none"
					],
					"enumDescriptions": [
						"%plua.hover.sourcePath.enumDescriptions.0%",
						"%plua.hover.sourcePath.enumDescriptions.1%",
						"%plua.hover.sourcePath.enumDescriptions.2%"
					],
					"default": "short",
					"markdownDescription": "%plua.hover.sourcePath.markdownDescription%"
				},
				"plua.hover.showFunctionBody": {
					"type": "boolean",
					"default": true,
					"description": "%plua.hover.showFunctionBody.description%"
				},
				"plua.hover.forPreview": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%plua.hover.forPreview.markdownDescription%"
				},
				"plua.hover.maxBodyLines": {
					"type": "integer",
					"default": 25,
					"minimum": 0,
					"markdownDescription": "%plua.hover.maxBodyLines.markdownDescription%"
				},
				"plua.hover.maxDeclarations": {
					"type": "integer",
					"default": 8,
					"minimum": 1,
					"description": "%plua.hover.maxDeclarations.description%"
				},
				"plua.highlight.paramNoDefault": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%plua.highlight.paramNoDefault.markdownDescription%"
				},
				"plua.highlight.paramNoDefaultColor": {
					"type": "string",
					"format": "color-hex",
					"default": "#E5C07B",
					"markdownDescription": "%plua.highlight.paramNoDefaultColor.markdownDescription%"
				},
				"plua.highlight.paramNoDefaultLightColor": {
					"type": "string",
					"format": "color-hex",
					"default": "#BF8803",
					"markdownDescription": "%plua.highlight.paramNoDefaultLightColor.markdownDescription%"
				},
				"plua.completion.defaultValues": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%plua.completion.defaultValues.markdownDescription%"
				},
				"plua.completion.defaultValuesDelayMs": {
					"type": "integer",
					"default": 800,
					"minimum": 0,
					"maximum": 10000,
					"markdownDescription": "%plua.completion.defaultValuesDelayMs.markdownDescription%"
				},
				"plua.highlight.paramNoType": {
					"type": "boolean",
					"default": true,
