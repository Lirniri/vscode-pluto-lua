<?xml version="1.0" encoding="UTF-8"?>
<plist version="1.0">
	<dict>
		<key>scope</key>
		<string>source.pluto - comment - string</string>
		<key>settings</key>
		<dict>
			<!-- Keep in sync with language-config.json -->
			<key>increaseIndentPattern</key>
			<string>(^\s*\$?(?!declare\s+function\b)\b((local)?[\s\w=]+)?\b(function(?!\s*\([^)]*\)\s*:)|repeat(?![^\n]*\buntil\b)|else|elseif|if|while|class|pluto_class|enum|pluto_enum|try|pluto_try|catch|pluto_catch)\b((?!\bend\b).)*$|^(?!\s*--).*\b(do|then)\b((?!\bend\b).)*$|^(?!\s*--).*\{((?!\}).)*$|^\s*(case\b.*|default)\s*:\s*$|^(?!\s*(?:--|\$)).*[(,=]\s*function\s*\([^)]*\)\s*(:\s*[\w?|.]+\s*)?$)</string>
			<key>decreaseIndentPattern</key>
			<string>(^\s*\$?\b(elsei|elseif|else|catch|pluto_catch|end|until)\b.*$|^((?!\{).)*\}\;?.*$|^\s*(case\b.*|default)\s*:\s*$)</string>
		</dict>
	</dict>
</plist>
